# Copy to .env (gitignored). Never commit real values.
# Generate the key locally with: npm run gen-wallet   (prints the address only)
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=
# Issued by Loops House at enrollment: loops project get --event agents-on-open-rails
ATTRIBUTION_TAG=celo_xxxxxxxxxxxx
# Set after ERC-8004 registration
AGENT_ID=
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
# x402 facilitator key from https://x402.celo.org (server-side secret, sent only to the facilitator)
X402_API_KEY=
